{
  "manifestVersion": 2,
  "id": "adaptive-thinking-plugin",
  "name": "任务自适应思考深度",
  "version": "0.3.4",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "minAppVersion": "0.1050.9",
  "capabilities": [
    "app/hooks.session-input",
    "app/hooks.observe",
    "app/input.status",
    "app/session.thinking-level",
    "app/sessions.read",
    "app/agents.read",
    "app/sessions.manage",
    "app/tools.expose-to-model",
    "app/models.infer"
  ],
  "description": "按当前任务与近期对话选择当前会话的思考档位，保留手动优先，并记录每轮实际档位。",
  "contributes": {
    "ui": {
      "inputStatus": [
        {
          "id": "auto-mode",
          "title": "自适应思考",
          "text": "自动选档状态",
          "tooltip": "点击切换当前会话的自动选档",
          "toolName": "adaptive_thinking_toggle"
        }
      ]
    },
    "settings": {
      "title": "自适应思考",
      "ui": { "route": "/settings.html" },
      "schema": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "scope": "per-agent",
            "title": "为此 Agent 启用自动思考档位",
            "description": "每条新用户消息会由当前 Agent 的 utility 模型分类，可能产生额外费用。"
          },
          "sessionAuto": {
            "type": "boolean",
            "default": true,
            "scope": "per-session",
            "title": "本会话自动模式",
            "description": "手动选择档位后自动暂停；重新开启后从下一条用户消息恢复。"
          }
        }
      }
    }
  }
}